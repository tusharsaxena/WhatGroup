## Interface: 120100
## Title: Ka0s WhatGroup
## Notes: Notifies you of group details after joining via Premade Group Finder
## Author: add1kted2ka0s
## Version: 1.4.0
## IconTexture: Interface\AddOns\WhatGroup\media\logos\whatgroup.logo.128.tga
## SavedVariables: WhatGroupDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Chat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1489907

# Libraries (must load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
# The launcher's two libraries (launcher-§1). LibKa0s-Launcher-1.0 resolves both with
# LibStub(..., true) at Register time rather than at load, so this position is conventional --
# but LibDBIcon needs CallbackHandler and LibDataBroker above it, and they are.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml

# Locales
locales\enUS.lua

# Core (CoreSetup first: it publishes the printer every later file reads, and
# core\WhatGroup.lua takes it as a file-scope upvalue)
core\CoreSetup.lua
# MediaSetup here and not later: core\WhatGroup.lua resolves NS.FONT_MONO from
# NS.MediaFont at load, so this slot is load-bearing, not conventional.
core\MediaSetup.lua
# NS.Windows and NS.FormatDuration; reads nothing at load, so this slot is conventional.
core\Util.lua
# Before core\WhatGroup.lua: it calls NS.Compat.AddOnLinkType() at file scope
# (core/WhatGroup.lua:93) to choose the chat-link route. Load-bearing.
core\Compat.lua
# The LibKa0s-Env seam. After Compat, and before settings\Panel.lua and settings\Slash.lua,
# the two files that read the TOC. Nothing here resolves at load beyond the LibStub lookup and
# both call sites read inside a function, so this slot is conventional, not load-bearing.
core\EnvSetup.lua
core\Database.lua
core\WhatGroup.lua
# After core\WhatGroup.lua, which assigns NS.FONT_MONO at load (core/WhatGroup.lua:182). The
# LibKa0s-DebugLog :New here runs at file scope (core/DebugLogSetup.lua:120) and the library
# validates `font` as a string, so above that line the console is built from nil. Load-bearing.
core\DebugLogSetup.lua
# The launcher (launcher-§1): one LibDataBroker object, the minimap button and the broker row.
# After core\DebugLogSetup.lua, which publishes NS.Debug. Conventional -- the object is built here
# but registered from OnEnable, and every seam it holds is read inside a closure.
core\LauncherSetup.lua
# The stand-down latch (slash-commands-§7): ONE LibKa0s-Lifecycle-1.0 instance, the `disabled` hold
# taken from the stored enable path and the `perf` hold reserved for the harness. Last in # Core and
# conventional: both host callbacks resolve NS.addon members at CALL time and the first call is from
# OnEnable, by which point every file below has loaded.
core\LifecycleSetup.lua

# Defaults (data tables; conventional apart from the annotated line)
# Before settings\Schema.lua: this file publishes NS.C, which Schema takes as a file-scope upvalue
# (settings/Schema.lua:29) and dereferences in every add{} at load. Load-bearing.
defaults\Profile.lua
defaults\TeleportSpells.lua

# Modules (conventional: modules\Frame.lua reads NS.addon and NS.L at file scope, both published
# above this group, and no later file reads anything of Frame's at load)
modules\Frame.lua
# The sections of `/wg diagnostics` (debug-logging-§14). Conventional: core\DebugLogSetup.lua's
# descriptor reads NS.Diagnostics at RUN time, and every read in the file is at call time.
modules\Diagnostics.lua

# Settings (conventional WITHIN the group apart from the three annotated lines; the group as a whole
# must follow # Core, because settings\Slash.lua:116 builds CLI_MISSING from NS.LIBKA0S_MISSING at
# file scope and core\CoreSetup.lua:34 publishes it)
# Directly above settings\Schema.lua: this file publishes Settings.SchemaLib (LibKa0s-Schema-1.0,
# or the host's degradation stub), and Schema.lua calls its :New at file scope
# (settings/Schema.lua:407). Above it that member does not exist yet. Load-bearing.
settings\SchemaSetup.lua
# Before settings\Panel.lua: this file creates Settings.Schema and its runtime NS.SchemaRuntime,
# which Panel splices its master rows into at file scope (settings/Panel.lua:301). Load-bearing.
settings\Schema.lua
# Before settings\Panel.lua: this file publishes the LibKa0s-Options instance as Settings.Helpers
# (settings/OptionsSetup.lua:303), and Panel calls Helpers.MasterControls at file scope
# (settings/Panel.lua:207). Above it that member does not exist yet. Load-bearing.
settings\OptionsSetup.lua
settings\Panel.lua
settings\Slash.lua
