## Interface: 120100
## Title: Ka0s WhatGroup
## Notes: Notifies you of group details after joining via Premade Group Finder
## Author: add1kted2ka0s
## Version: 1.4.0
## IconTexture: 134149
## SavedVariables: WhatGroupDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0
## DefaultState: enabled
## Category-enUS: Chat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1489907

# Libraries (must load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibKa0s\LibKa0s.xml

# Locales
locales\enUS.lua

# Core (CoreSetup first: it publishes the printer every later file reads, and
# core\WhatGroup.lua takes it as a file-scope upvalue)
core\CoreSetup.lua
# MediaSetup here and not later: core\WhatGroup.lua resolves NS.FONT_MONO from
# NS.MediaFont at load, so this slot is load-bearing, not conventional.
core\MediaSetup.lua
core\Util.lua
core\Compat.lua
# The LibKa0s-Env seam. After Compat, and before settings\Panel.lua and settings\Slash.lua,
# the two files that read the TOC. Nothing here resolves at load beyond the LibStub lookup and
# both call sites read inside a function, so this slot is conventional, not load-bearing.
core\EnvSetup.lua
core\Database.lua
core\WhatGroup.lua
# After core\WhatGroup.lua, which assigns NS.FONT_MONO at load (core/WhatGroup.lua:128). The
# LibKa0s-DebugLog :New here runs at file scope (core/DebugLogSetup.lua:120) and the library
# validates `font` as a string, so above that line the console is built from nil. Load-bearing.
core\DebugLogSetup.lua

# Defaults (data tables; conventional apart from the annotated line)
# Before settings\Schema.lua: this file publishes NS.C, which Schema takes as a file-scope upvalue
# (settings/Schema.lua:27) and dereferences in every add{} at load. Load-bearing.
defaults\Profile.lua
defaults\TeleportSpells.lua

# Modules (conventional: modules\Frame.lua reads NS.addon and NS.L at file scope, both published
# above this group, and no later file reads anything of Frame's at load)
modules\Frame.lua

# Settings (conventional WITHIN the group apart from the two annotated lines; the group as a whole
# must follow # Core, because settings\Slash.lua:67 builds CLI_MISSING from NS.LIBKA0S_MISSING at
# file scope and core\CoreSetup.lua:34 publishes it)
# Before settings\Panel.lua: this file creates Settings.Schema, which Panel splices its master rows
# into at file scope (settings/Panel.lua:268). Load-bearing.
settings\Schema.lua
# Before settings\Panel.lua: this file publishes the LibKa0s-Options instance as Settings.Helpers
# (settings/OptionsSetup.lua:273), and Panel calls Helpers.MasterControls at file scope
# (settings/Panel.lua:204). Above it that member does not exist yet. Load-bearing.
settings\OptionsSetup.lua
settings\Panel.lua
settings\Slash.lua
